      "name": "01. Legacy SOAP Services",
      "item": [
        {
          "name": "GET WSDL Kontrak Layanan (XML)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/soap/sipus.wsdl",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["soap", "sipus.wsdl"]
            }
          }
        },
        {
          "name": "POST SOAP CheckClearanceStatus (Sukses / Bebas Pustaka)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/library\">\n    <soap:Body>\n        <m:CheckClearanceStatusRequest>\n            <m:nim_peminjam>12S24035</m:nim_peminjam>\n        </m:CheckClearanceStatusRequest>\n    </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8000/soap/sipus",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["soap", "sipus"]
            }
          }
        },
        {
          "name": "POST SOAP Malformed / Empty (Uji SOAP Fault 500)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n    <soap:Body>\n        <m:CheckClearanceStatusRequest>\n            <!-- Tag nim_peminjam sengaja dikosongkan -->\n        </m:CheckClearanceStatusRequest>\n    </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8000/soap/sipus",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["soap", "sipus"]
            }
          }
        }
